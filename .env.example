# Flask
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
PORT=5000

# Supabase project URL and publishable/anon key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only secret. Never expose this to browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase PostgreSQL connection string. Use the Session Pooler or direct connection string.
# Keep the password secret and require SSL.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=require
